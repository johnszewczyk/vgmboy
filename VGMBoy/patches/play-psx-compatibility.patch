+void CPsfVm::SetErrorHandler(const ErrorHandler& handler)
+{
+	std::lock_guard lock(m_errorMutex);
+	m_errorHandler = handler;
+}
+
+bool CPsfVm::HasError() const
+{
+	std::lock_guard lock(m_errorMutex);
+	return !m_errorMessage.empty();
+}
+
+std::string CPsfVm::GetErrorMessage() const
+{
+	std::lock_guard lock(m_errorMutex);
+	return m_errorMessage;
+}
+
+void CPsfVm::ClearError()
+{
+	std::lock_guard lock(m_errorMutex);
+	m_errorMessage.clear();
+}
+
+void CPsfVm::ReportThreadError(const std::string& message)
+{
+	ErrorHandler handler;
+	{
+		std::lock_guard lock(m_errorMutex);
+		if(!m_errorMessage.empty()) return;
+		m_errorMessage = message;
+		handler = m_errorHandler;
+	}
+	m_status = PAUSED;
+	if(handler) handler(message);
+}
