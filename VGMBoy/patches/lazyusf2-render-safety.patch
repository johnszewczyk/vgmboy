diff --git a/r4300/pure_interp.c b/r4300/pure_interp.c
--- a/r4300/pure_interp.c
+++ b/r4300/pure_interp.c
@@ -740,8 +740,17 @@ void pure_interpreter(usf_state_t * state)
    state->stop = 0;
    state->PC = &state->interp_PC;
 
+   unsigned int watchdog_counter = 0;
    while (!state->stop)
    {
      InterpretOpcode(state);
+     if ((++watchdog_counter & 0xFFF) == 0)
+     {
+       if (usf_render_watchdog_expired_state(state))
+       {
+         state->stop = 1;
+         break;
+       }
+     }
    }
 }
