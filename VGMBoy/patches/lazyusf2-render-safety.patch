+            USF_STATE->error_message,
+            sizeof(USF_STATE->error_message),
+            "USF emulation exceeded the %u ms render safety limit.",
+            USF_STATE->render_timeout_ms
+        );
+        USF_STATE->last_error = USF_STATE->error_message;
+        return USF_STATE->last_error;
+    }
+
     if ( sample_rate )
         *sample_rate = USF_STATE->SampleRate;
 
