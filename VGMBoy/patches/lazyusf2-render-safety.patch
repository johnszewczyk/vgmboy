diff --git a/usf/usf.c b/usf/usf.c
--- a/usf/usf.c
+++ b/usf/usf.c
@@ -1,5 +1,6 @@
 #include <stdint.h>
 #include <string.h>
 #include <stdio.h>
+#include <time.h>
 
 #include "usf.h"
@@ -77,7 +78,33 @@ void usf_set_hle_audio(void * state, int enable)
 {
     USF_STATE->enable_hle_audio = enable;
 }
 
+void usf_set_render_timeout_ms(void * state, uint32_t timeout_ms)
+{
+    USF_STATE->render_timeout_ms = timeout_ms;
+}
+
+static uint64_t monotonic_time_ns(void)
+{
+    struct timespec time_value;
+    if (clock_gettime(CLOCK_MONOTONIC, &time_value) != 0)
+        return 0;
+    return (uint64_t)time_value.tv_sec * 1000000000ULL + (uint64_t)time_value.tv_nsec;
+}
+
+int usf_render_watchdog_expired_state(usf_state_t *state)
+{
+    if (!state->render_deadline_ns || monotonic_time_ns() < state->render_deadline_ns)
+        return 0;
+    state->render_timed_out = 1;
+    return 1;
+}
+
+int usf_render_watchdog_expired(void *state)
+{
+    return usf_render_watchdog_expired_state(USF_STATE);
+}
+
 void usf_set_trimming_mode(void * state, int enable)
 {
     USF_STATE->enable_trimming_mode = enable;
