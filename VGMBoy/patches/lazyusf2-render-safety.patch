+    USF_STATE->render_timed_out = 0;
+    USF_STATE->render_deadline_ns = USF_STATE->render_timeout_ms
+        ? monotonic_time_ns() + (uint64_t)USF_STATE->render_timeout_ms * 1000000ULL
+        : 0;
 
     if ( !USF_STATE->MemoryState )
@@ -360,6 +405,18 @@ const char * usf_render(void * state, int16_t * buffer, size_t count, int32_t * s
 
     main_run(USF_STATE);
 
+    USF_STATE->render_deadline_ns = 0;
+    if (USF_STATE->render_timed_out) {
